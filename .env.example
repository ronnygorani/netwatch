# Environment variable template.
# Copy to .env and fill in real values: cp .env.example .env
# The .env file is gitignored — never commit real credentials.

# PostgreSQL
POSTGRES_USER=netwatch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=netwatch
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Browser origins allowed by CORS, comma-separated ("*" = allow all — dev only)
CORS_ORIGINS=*

# Runtime environment tag (development | staging | production)
ENVIRONMENT=development

# Poller service
POLL_INTERVAL_SECONDS=60
POLLER_MAX_WORKERS=10
NETMIKO_USERNAME=your_ssh_username
NETMIKO_PASSWORD=your_ssh_password

# API key for the poller (metric writes require auth). Mint one with:
#   docker compose exec api python -m app.create_api_key poller "metrics:write"
# and paste the printed key here — it is shown only once.
NETWATCH_API_KEY=

# Job queue broker (RQ over Redis). DB 2 avoids Nautobot's 0 and 1.
REDIS_URL=redis://redis:6379/2

# Human auth. Rotating this invalidates every issued token.
JWT_SECRET=changeme_32_random_chars
JWT_EXPIRE_MINUTES=60

# Config snapshot sweep cadence. This is also the drift check, so it doubles as
# the detection latency for an unauthorized config change. 0 disables.
BACKUP_INTERVAL_HOURS=6

# A config change counts as authorized if a change targeting that device
# executed within this many minutes of the sweep that spotted it.
DRIFT_CORRELATION_MINUTES=60

# Nautobot (source of truth). Generate strong random values for all of these.
NAUTOBOT_DB_PASSWORD=changeme
NAUTOBOT_SECRET_KEY=changeme_50_random_chars
NAUTOBOT_SUPERUSER_PASSWORD=changeme
NAUTOBOT_TOKEN=changeme_40_hex_chars
NAUTOBOT_WEBHOOK_SECRET=changeme_48_hex_chars
