# Environment variable template.
# Copy to .env and fill in real values: cp .env.example .env
# The .env file is gitignored — never commit real credentials.

# PostgreSQL — split into parts so individual values can be rotated
# in a secrets manager without rebuilding the full connection string.
POSTGRES_USER=netwatch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=netwatch
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Runtime environment tag (development | staging | production)
ENVIRONMENT=development
